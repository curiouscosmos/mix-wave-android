<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="20dp" />
            <gradient android:angle="0" android:startColor="@color/discourse_catalogue_surface_start" android:endColor="@color/discourse_catalogue_surface_end" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="20dp" />
            <gradient android:type="radial" android:centerX="0.3" android:centerY="0.15" android:gradientRadius="280dp" android:startColor="@color/discourse_card_glow" android:endColor="@color/discourse_card_glow_clear" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/discourse_catalogue_border" />
        </shape>
    </item>
</layer-list>
