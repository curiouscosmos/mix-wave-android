<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/listening_stats_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stats_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/listening_stats_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/listening_stats_heading"
        app:titleTextAppearance="@style/ListeningStatsToolbarTitle"
        app:navigationIconTint="@color/stats_text"
        app:titleTextColor="@color/stats_text" />

    <ScrollView
        android:id="@+id/listening_stats_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/listening_stats_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="20dp" />
    </ScrollView>
</LinearLayout>
