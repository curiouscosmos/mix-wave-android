<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/discourse_catalogue_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/discourse_catalogue_card_background"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/discourse_image"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/DiscourseCatalogueArtwork" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/discourse_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/discourse_catalogue_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/discourse_catalogue_text" />
                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/discourse_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/discourse_catalogue_secondary"
                        android:textSize="11sp"
                        android:gravity="center_vertical"
                        android:drawablePadding="4dp"
                        android:background="@drawable/discourse_metadata_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="5dp"
                        android:drawableStart="@drawable/ic_discourse_language"
                        android:drawableTint="@color/discourse_catalogue_secondary"
                        android:maxWidth="110dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView
                        android:id="@+id/discourse_location"
                        app:layout_constraintStart_toEndOf="@id/discourse_language"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintHorizontal_bias="0"
                        android:layout_marginStart="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/discourse_catalogue_secondary"
                        android:textSize="11sp"
                        android:gravity="center_vertical"
                        android:drawablePadding="4dp"
                        android:background="@drawable/discourse_metadata_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="5dp"
                        android:drawableStart="@drawable/ic_discourse_location"
                        android:drawableTint="@color/discourse_catalogue_secondary"
                        android:visibility="gone" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/discourse_counts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/discourse_catalogue_secondary"
                        android:textSize="11sp"
                        android:gravity="center_vertical"
                        android:drawablePadding="4dp"
                        android:drawableStart="@drawable/ic_discourse_tracks"
                        android:drawableTint="@color/discourse_catalogue_secondary" />
                    <TextView
                        android:id="@+id/discourse_date_separator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/discourse_catalogue_secondary"
                        android:textSize="11sp"
                        android:gravity="center_vertical"
                        android:drawablePadding="4dp"
                        android:text=" | "
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/discourse_date"
                        android:layout_width="0dp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeMaxTextSize="11sp"
                        android:autoSizeStepGranularity="1sp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/discourse_catalogue_secondary"
                        android:textSize="11sp"
                        android:gravity="center_vertical"
                        android:drawablePadding="4dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_discourse_calendar"
                        android:drawableTint="@color/discourse_catalogue_secondary"
                        android:visibility="gone" />
                    <Space
                        android:id="@+id/discourse_metadata_space"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />
                    <ImageView
                        android:id="@+id/discourse_download_icon"
                        android:layout_width="18dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_download"
                        android:tint="@color/discourse_catalogue_secondary" />
                    <TextView
                        android:id="@+id/discourse_downloaded_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/discourse_catalogue_secondary"
                        android:textSize="11sp"
                        android:gravity="center_vertical"
                        android:drawablePadding="4dp"
                        android:visibility="gone" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" | "
                        android:textColor="@color/discourse_catalogue_secondary" />
                    <TextView
                        android:id="@+id/discourse_like"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="4dp"
                        android:drawablePadding="3dp"
                        android:textSize="11sp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <include
            layout="@layout/discourse_download_progress" />
        <include
            layout="@layout/discourse_listening_progress"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="6dp" />
    </LinearLayout>
</LinearLayout>
