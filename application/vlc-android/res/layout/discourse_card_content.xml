<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/discourse_catalogue_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/discourse_catalogue_card_background"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="12dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/discourse_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.22"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/DiscourseCatalogueArtwork" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/discourse_image"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="8dp"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/discourse_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/discourse_catalogue_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/discourse_catalogue_text" />
                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/discourse_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/discourse_card_secondary"
                        android:textSize="12sp"
                        android:gravity="center_vertical"
                        android:drawablePadding="4dp"
                        android:background="@drawable/discourse_metadata_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="6dp"
                        android:drawableStart="@drawable/ic_discourse_language"
                        android:drawableTint="@color/discourse_card_secondary"
                        android:maxWidth="110dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView
                        android:id="@+id/discourse_location"
                        app:layout_constraintStart_toEndOf="@id/discourse_language"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintHorizontal_bias="0"
                        android:layout_marginStart="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/discourse_card_secondary"
                        android:textSize="12sp"
                        android:gravity="center_vertical"
                        android:drawablePadding="4dp"
                        android:background="@drawable/discourse_metadata_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="6dp"
                        android:drawableStart="@drawable/ic_discourse_location"
                        android:drawableTint="@color/discourse_card_secondary"
                        android:visibility="gone" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:id="@+id/discourse_card_details"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/discourse_counts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/discourse_card_secondary"
                        android:textSize="11sp"
                        android:gravity="center_vertical"
                        android:drawablePadding="4dp"
                        android:drawableStart="@drawable/ic_discourse_tracks"
                        android:drawableTint="@color/discourse_card_secondary" />
                    <View
                        android:id="@+id/discourse_date_separator"
                        android:layout_width="1dp"
                        android:layout_height="16dp"
                        android:layout_marginHorizontal="5dp"
                        android:background="@color/discourse_card_secondary"
                        android:alpha="0.6"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/discourse_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/discourse_card_secondary"
                        android:textSize="11sp"
                        android:gravity="center_vertical"
                        android:drawablePadding="4dp"
                        android:drawableStart="@drawable/ic_discourse_calendar"
                        android:drawableTint="@color/discourse_card_secondary"
                        android:visibility="gone" />

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/discourse_card_actions"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/discourse_download_icon"
                        android:layout_width="22dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_discourse_download"
                        android:tint="@color/discourse_card_secondary" />
                    <TextView
                        android:id="@+id/discourse_downloaded_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/discourse_card_secondary"
                        android:textSize="12sp"
                        android:gravity="center_vertical"
                        android:drawablePadding="4dp"
                        android:visibility="gone" />
                    <View
                        android:layout_width="1dp"
                        android:layout_height="16dp"
                        android:layout_marginHorizontal="5dp"
                        android:background="@color/discourse_card_secondary"
                        android:alpha="0.6" />
                    <TextView
                        android:id="@+id/discourse_like"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="4dp"
                        android:drawablePadding="3dp"
                        android:textSize="11sp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone" />

                    </LinearLayout>
                    <androidx.constraintlayout.helper.widget.Flow
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:constraint_referenced_ids="discourse_card_details,discourse_card_actions"
                        app:flow_wrapMode="chain"
                        app:flow_horizontalGap="4dp"
                        app:flow_verticalGap="0dp"
                        app:flow_firstHorizontalStyle="spread_inside"
                        app:flow_firstHorizontalBias="0"
                        app:flow_lastHorizontalStyle="packed"
                        app:flow_lastHorizontalBias="1"
                        app:flow_verticalAlign="center" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include
            layout="@layout/discourse_download_progress" />
        <include
            layout="@layout/discourse_listening_progress"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
