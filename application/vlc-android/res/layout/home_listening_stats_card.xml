<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/discourse_track_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="96dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <ImageView
        android:id="@+id/home_listening_stats_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/home_listening_stats_icon_background"
        android:contentDescription="@null"
        android:padding="10dp"
        android:src="@drawable/ic_home_listening_stats"
        android:tint="@color/track_card_continue_label" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/home_listening_stats_label"
            android:textColor="@color/track_card_continue_label"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/home_listening_stats_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/home_listening_stats"
            android:textColor="@color/discourse_track_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/home_listening_stats_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/discourse_track_secondary"
            android:textSize="12sp"
            tools:text="2h 15min this week · 256 Downloads" />
    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_home_listening_stats_arrow"
        android:tint="@color/discourse_track_secondary" />
</LinearLayout>
