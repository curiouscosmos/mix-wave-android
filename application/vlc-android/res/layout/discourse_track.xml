<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/discourse_track_card"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="112dp"
    android:padding="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/discourse_track_image"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/TrackCardArtwork"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/discourse_track_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:background="@drawable/discourse_track_number_background"
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toStartOf="@id/discourse_track_image"
        app:layout_constraintTop_toTopOf="@id/discourse_track_image" />

    <LinearLayout
        android:id="@+id/discourse_track_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@id/discourse_track_image"
        app:layout_constraintEnd_toStartOf="@id/discourse_track_play"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/listening_progress"
        app:layout_constraintVertical_bias="0">

        <TextView
            android:id="@+id/discourse_track_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/discourse_track_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/discourse_track_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/discourse_track_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/discourse_track_likes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/discourse_track_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <include layout="@layout/discourse_download_progress" />
    </LinearLayout>

    <ProgressBar
        android:id="@id/listening_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@drawable/track_listening_progress"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/discourse_track_text"
        app:layout_constraintEnd_toEndOf="@id/discourse_track_text"
        app:layout_constraintBottom_toBottomOf="parent" />

    <include
        layout="@layout/discourse_like_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintStart_toStartOf="@id/discourse_track_play"
        app:layout_constraintEnd_toEndOf="@id/discourse_track_play"
        app:layout_constraintTop_toBottomOf="@id/discourse_track_play"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="1" />

    <ImageButton
        android:id="@+id/discourse_track_play"
        style="@style/TrackCardPlayButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/discourse_track_download"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/more_actions"
        android:src="@drawable/ic_player_more"
        android:tint="@color/discourse_track_text"
        app:layout_constraintEnd_toEndOf="@id/discourse_track_play"
        app:layout_constraintTop_toTopOf="@id/discourse_track_play" />
</androidx.constraintlayout.widget.ConstraintLayout>
