<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/audio_player_screen_background">
    <LinearLayout
            android:id="@+id/audio_mixer_selected_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginVertical="12dp"
            android:background="@drawable/audio_mixer_selected_background"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:visibility="gone">
        <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_song"
                app:tint="@color/audio_mixer_banner_icon" />
        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/audio_mixer_selected_label"
                    android:textColor="@color/audio_mixer_accent"
                    android:letterSpacing="0.08"
                    android:textSize="12sp" />
            <TextView
                    android:id="@+id/audio_mixer_selected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/audio_mixer_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/audio_list"
            android:layout_width="@dimen/default_content_width"
            android:layout_height="0dp"
            android:layout_gravity="center_horizontal"
            android:layout_weight="1"
            android:paddingHorizontal="12dp"
            android:clipToPadding="false" />

    <com.google.android.material.card.MaterialCardView
            android:id="@+id/audio_mixer_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"
            app:cardBackgroundColor="@color/audio_mixer_card"
            app:strokeColor="@color/audio_mixer_card_border"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <LinearLayout
                    android:id="@+id/audio_mixer_panel_header"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:rotation="90"
                        app:srcCompat="@drawable/ic_equalizer"
                        app:tint="@color/audio_mixer_accent" />
                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/audio_mixer_panel_title"
                        android:textColor="@color/audio_mixer_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/audio_mixer_panel_chevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:rotation="180"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/discourse_catalogue_chevron_down"
                        app:tint="@color/audio_mixer_text" />
            </LinearLayout>
            <LinearLayout
                    android:id="@+id/audio_mixer_panel_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/audio_mixer_off"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:textAllCaps="false"
                        android:text="@string/audio_mixer_turn_off"
                        android:textColor="@color/audio_mixer_toggle_foreground"
                        app:iconTint="@color/audio_mixer_toggle_foreground"
                        app:strokeColor="@color/audio_mixer_accent"
                        app:strokeWidth="1dp"
                        app:cornerRadius="5dp"
                        app:backgroundTint="@color/audio_mixer_toggle_background"
                        app:icon="@drawable/ic_play"
                        app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/audio_mixer_loop"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:minHeight="48dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:checked="true"
                        android:textAllCaps="false"
                        android:text="@string/audio_mixer_loop"
                        android:textColor="@color/audio_mixer_accent"
                        app:iconTint="@color/audio_mixer_accent"
                        app:strokeColor="@color/audio_mixer_accent"
                        app:strokeWidth="1dp"
                        app:cornerRadius="5dp"
                        app:backgroundTint="@color/audio_mixer_toggle_background_default"
                        app:iconSize="20dp" />

                <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/audio_mixer_more"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/more_actions"
                        app:srcCompat="@drawable/ic_more"
                        app:tint="?attr/colorControlNormal" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/audio_mixer_text_secondary"
                        android:text="@string/audio_mixer_volume"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/audio_mixer_volume_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/audio_mixer_text_secondary"
                        android:textStyle="bold"
                        android:text="100%" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/audio_mixer_volume_down"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:contentDescription="@string/air_action_volume_down"
                        android:textColor="@color/audio_mixer_accent"
                        android:textSize="22sp"
                        android:text="−" />

                <com.google.android.material.slider.Slider
                        android:id="@+id/audio_mixer_volume"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="0dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/audio_mixer_volume"
                        android:value="50"
                        android:valueFrom="1"
                        android:valueTo="100"
                        android:stepSize="1"
                        app:thumbColor="@color/audio_mixer_accent"
                        app:trackColorActive="@color/audio_mixer_accent"
                        app:trackColorInactive="@color/audio_mixer_slider_inactive"
                        app:tickVisible="false" />

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/audio_mixer_volume_up"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:contentDescription="@string/air_action_volume_up"
                        android:textColor="@color/audio_mixer_accent"
                        android:textSize="22sp"
                        android:text="+" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
