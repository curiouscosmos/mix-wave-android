<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/discourse_catalogue"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Spinner
                android:id="@+id/discourse_language_filter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/discourse_language_filter" />

            <Spinner
                android:id="@+id/discourse_sort_filter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/discourse_sort_filter" />
        </LinearLayout>

        <TextView
            android:id="@+id/discourse_catalogue_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/discourse_empty"
            android:visibility="gone" />

        <org.videolan.vlc.gui.view.SwipeRefreshLayout
            android:id="@+id/discourse_grid_swipe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/discourse_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"
            android:scrollbars="none" />
        </org.videolan.vlc.gui.view.SwipeRefreshLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/discourse_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <org.videolan.vlc.gui.view.SwipeRefreshLayout
            android:id="@+id/discourse_tracks_swipe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/discourse_tracks"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </org.videolan.vlc.gui.view.SwipeRefreshLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/discourse_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ProgressBar
            android:id="@+id/discourse_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/discourse_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center" />

        <Button
            android:id="@+id/discourse_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/retry"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
