<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/discourse_catalogue_background">

    <LinearLayout
        android:id="@+id/discourse_catalogue"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/discourse_catalogue_background"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/discourse_catalogue_filter_background">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_language"
                    android:tint="@color/discourse_catalogue_secondary" />
                <Spinner
                    android:id="@+id/discourse_language_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@null"
                    android:paddingStart="46dp"
                    android:paddingEnd="30dp"
                    android:contentDescription="@string/discourse_language_filter" />
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/discourse_catalogue_chevron_down" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/discourse_catalogue_filter_background">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sort"
                    android:tint="@color/discourse_catalogue_secondary" />
                <Spinner
                    android:id="@+id/discourse_sort_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@null"
                    android:paddingStart="46dp"
                    android:paddingEnd="30dp"
                    android:contentDescription="@string/discourse_sort_filter" />
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/discourse_catalogue_chevron_down" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/discourse_catalogue_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/discourse_empty"
            android:textColor="@color/discourse_catalogue_secondary"
            android:visibility="gone" />

        <org.videolan.vlc.gui.view.SwipeRefreshLayout
            android:id="@+id/discourse_grid_swipe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/discourse_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingBottom="10dp"
            android:scrollbars="none" />
        </org.videolan.vlc.gui.view.SwipeRefreshLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/discourse_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <org.videolan.vlc.gui.view.SwipeRefreshLayout
            android:id="@+id/discourse_tracks_swipe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/discourse_tracks"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </org.videolan.vlc.gui.view.SwipeRefreshLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/discourse_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ProgressBar
            android:id="@+id/discourse_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/discourse_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center" />

        <Button
            android:id="@+id/discourse_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/retry"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
