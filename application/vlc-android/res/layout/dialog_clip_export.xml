<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/clip_export_background"
            android:orientation="vertical">

        <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/clip_export_handle_background" />

        <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="16dp">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/clip_export_title"
                    android:textColor="@color/clip_export_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/clip_export_close"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/clip_export_close_background"
                    android:contentDescription="@string/close"
                    android:padding="8dp"
                    android:src="@drawable/ic_close_small"
                    app:tint="@color/clip_export_text" />
        </FrameLayout>

        <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

            <LinearLayout
                    android:id="@+id/clip_export_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="32dp">

                <LinearLayout
                        android:id="@+id/clip_export_media"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/clip_export_artwork"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/OshoThumbnailShapeAppearanceOverlay" />

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                        <TextView
                                android:id="@+id/clip_export_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="@color/clip_export_text"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="Es Dhammo Sanantano 001" />

                        <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/clip_export_range_background"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp">

                            <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_player_clip"
                                    android:tint="@color/clip_export_chip_text" />

                            <TextView
                                    android:id="@+id/clip_export_range"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:textColor="@color/clip_export_chip_text"
                                    android:textSize="15sp"
                                    tools:text="13:55 – 14:24" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                        android:id="@+id/clip_export_effects"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/clip_export_card_background"
                        android:orientation="vertical">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                        <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_clip_noise"
                                android:tint="@color/clip_export_icon" />

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_weight="1"
                                android:text="@string/clip_noise_cancellation"
                                android:textColor="@color/clip_export_text"
                                android:textSize="16sp" />

                        <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/clip_export_noise_switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:enabled="false"
                                android:focusable="false"
                                app:thumbTint="@color/clip_export_switch_thumb"
                                app:trackTint="@color/clip_export_switch_track" />
                    </LinearLayout>

                    <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="16dp"
                            android:background="@color/clip_export_divider" />

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                        <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_song"
                                android:tint="@color/clip_export_icon" />

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_weight="1"
                                android:text="@string/clip_background_music"
                                android:textColor="@color/clip_export_text"
                                android:textSize="16sp" />

                        <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/clip_export_music_switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:enabled="false"
                                android:focusable="false"
                                app:thumbTint="@color/clip_export_switch_thumb"
                                app:trackTint="@color/clip_export_switch_track" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                        android:id="@+id/clip_export_actions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/clip_export_share"
                            style="@style/Widget.MaterialComponents.Button.Icon"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/clip_share_link"
                            android:textAllCaps="false"
                            android:textColor="@color/clip_export_text"
                            android:textSize="17sp"
                            app:backgroundTint="@color/clip_export_accent"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_link"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp"
                            app:iconTint="@color/clip_export_text"
                            app:rippleColor="@color/clip_export_accent_pressed" />

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/clip_export_download"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="12dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/clip_download"
                            android:textAllCaps="false"
                            android:textColor="@color/clip_export_text"
                            android:textSize="17sp"
                            app:backgroundTint="@android:color/transparent"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_download"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp"
                            app:iconTint="@color/clip_export_text"
                            app:rippleColor="@color/clip_export_accent_pressed"
                            app:strokeColor="@color/clip_export_accent"
                            app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/clip_export_video"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="12dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/clip_create_video"
                            android:textAllCaps="false"
                            android:textColor="@color/clip_export_text"
                            android:textSize="17sp"
                            app:backgroundTint="@android:color/transparent"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_clip_video"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp"
                            app:iconTint="@color/clip_export_text"
                            app:rippleColor="@color/clip_export_accent_pressed"
                            app:strokeColor="@color/clip_export_accent"
                            app:strokeWidth="1dp" />
                </LinearLayout>

                <LinearLayout
                        android:id="@+id/clip_export_progress_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                    <TextView
                            android:id="@+id/clip_export_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:gravity="center"
                            android:textColor="@color/clip_export_text_secondary"
                            android:textSize="15sp" />

                    <ProgressBar
                            android:id="@+id/clip_export_progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:max="100" />

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/clip_export_cancel"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="20dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/cancel"
                            android:textAllCaps="false"
                            android:textColor="@color/clip_export_text"
                            android:textSize="17sp"
                            app:backgroundTint="@android:color/transparent"
                            app:cornerRadius="16dp"
                            app:rippleColor="@color/clip_export_accent_pressed"
                            app:strokeColor="@color/clip_export_accent"
                            app:strokeWidth="1dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
